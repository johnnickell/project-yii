<?xml version="1.0"?>
<ruleset name="Project Yii">
    <description>Common's shipped standard with Yii-owned scan scope.</description>
    <file>src</file>
    <file>tests</file>
    <file>scripts/build.php</file>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <config name="installed_paths" value="vendor/slevomat/coding-standard"/>
    <rule ref="./vendor/johnnickell/fight-common/src/Standards/Phpcs/ruleset.xml"/>
</ruleset>
