{
    "name": "johnnickell/project-yii",
    "description": "Public Yii application composition for Fight libraries.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "johnnickell/fight-access-control": "dev-develop",
        "johnnickell/fight-common": "^1.1",
        "nyholm/psr7": "^1.8",
        "yiisoft/cache": "^3.2",
        "yiisoft/config": "^1.6",
        "yiisoft/db": "^1.0",
        "yiisoft/db-mysql": "^1.0",
        "yiisoft/db-pgsql": "^1.0",
        "yiisoft/di": "^1.4",
        "yiisoft/event-dispatcher": "^1.1",
        "yiisoft/log": "^2.2",
        "yiisoft/mailer": "^6.1",
        "yiisoft/router": "^4.0",
        "yiisoft/router-fastroute": "^4.0",
        "yiisoft/session": "^3.0",
        "yiisoft/validator": "^2.0",
        "yiisoft/view": "^11.0",
        "yiisoft/view-twig": "^3.0",
        "yiisoft/yii-console": "^2.4",
        "yiisoft/yii-http": "^1.1"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/johnnickell/fight-access-control"
        }
    ],
    "config": {
        "platform": {
            "php": "8.5.4"
        },
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {
            "yiisoft/config": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "extra": {
        "config-plugin-options": {
            "source-directory": "config"
        },
        "config-plugin": {
            "providers": "providers.php",
            "seams": "seams.php"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
