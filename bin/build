#!/usr/bin/env sh
set -eu

worktree_checksum=$(pwd -P | cksum | awk '{print $1}')
image="project-yii-build-$worktree_checksum"

./bin/planning-check

docker build --file etc/docker/fpm/Dockerfile --tag "$image" .
docker run --rm --volume "$(pwd):/app" --workdir /app "$image" sh -ec '
    php scripts/composer-candidate-validation.php
    php scripts/fight-common-candidate-check.php
    composer install --no-interaction --prefer-dist --no-progress
    php scripts/framework-support-profile.php --assert-lane .
    php scripts/generate-framework-support-receipt.php
    scripts/verify-dependency-lanes.sh

    work_root=$(mktemp -d)
    trap "rm -rf \"$work_root\"" EXIT
    git clone --quiet --no-checkout https://github.com/johnnickell/fight-common "$work_root/fight-common"
    git -C "$work_root/fight-common" checkout --quiet --detach 4a798b1db8fdb5e4af7d0ba8c98a88ac53c50c16
    php scripts/verify-framework-support-receipt.php "$work_root/fight-common"

    php scripts/public-contract-check.php
    php scripts/governance-check.php
    php scripts/architecture-check.php
    php scripts/docs-check.php
    php tests/regression/quality-gate.php
    PROJECT_YII_IN_BUILD=1 ./bin/phpunit

    production_root="$work_root/production"
    mkdir "$production_root"
    tar --exclude=.git --exclude=vendor --exclude=.runs --exclude=var -cf - . | tar -C "$production_root" -xf -
    cd "$production_root"
    composer install --no-dev --no-interaction --prefer-dist --no-progress
    php scripts/public-contract-check.php
    php scripts/verify-production-framework-support-profile.php
'
