#!/usr/bin/env sh
set -eu

worktree_checksum=$(pwd -P | cksum | awk '{print $1}')
image="project-yii-build-$worktree_checksum"
host_uid=$(id -u)
host_gid=$(id -g)

./bin/planning-check

docker build --file etc/docker/fpm/Dockerfile --tag "$image" .
docker run --rm --user "$host_uid:$host_gid" --volume "$(pwd):/app" --workdir /app "$image" sh -ec '
    php-fpm -tt
    composer validate
    composer install --no-interaction --prefer-dist --no-progress
    vendor/bin/phpcs
    vendor/bin/phpstan analyse --no-progress
    vendor/bin/deptrac analyse --no-progress --fail-on-uncovered
    vendor/bin/rector process --dry-run --no-progress-bar
    mkdir -p var/coverage
    rm -f var/coverage/unit-clover.xml
    PROJECT_YII_IN_BUILD=1 ./bin/phpunit --testsuite Unit --coverage-clover var/coverage/unit-clover.xml
    php scripts/verify-coverage.php var/coverage/unit-clover.xml src
    PROJECT_YII_IN_BUILD=1 ./bin/phpunit --testsuite Integration
    PROJECT_YII_IN_BUILD=1 ./bin/phpunit --testsuite Functional

    work_root=$(mktemp -d)
    trap "rm -rf \"$work_root\"" EXIT
    production_root="$work_root/production"
    mkdir "$production_root"
    tar --exclude=.git --exclude=vendor --exclude=.runs --exclude=var -cf - . | tar -C "$production_root" -xf -
    cd "$production_root"
    composer install --no-dev --no-interaction --prefer-dist --no-progress
    php tests/Functional/production-boot.php
'
